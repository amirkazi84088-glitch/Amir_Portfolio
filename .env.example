# ══════════════════════════════════════════════════════
#  Copy this to .env.local for local dev
#  On Vercel/Railway: add in Variables tab
# ══════════════════════════════════════════════════════

# OPTION A: Full URL — easiest — get from Railway MySQL → Connect tab
MYSQL_PUBLIC_URL=mysql://root:password@roundhouse.proxy.rlwy.net:PORT/railway

# OPTION B: Individual vars (Railway format — no underscore gap)
MYSQLHOST=roundhouse.proxy.rlwy.net
MYSQLPORT=12345
MYSQLUSER=root
MYSQLPASSWORD=your-railway-mysql-password
MYSQLDATABASE=railway

# Auth
JWT_SECRET=amir_kazi_super_secret_jwt_2026_team_error404_change_this

# App URL
NEXT_PUBLIC_SITE_URL=https://your-app.up.railway.app

# Cloudinary (for photo upload) — free at cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
